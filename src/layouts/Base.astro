---
import Font from 'astro/components/Font.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Meta from '../components/seo/Meta.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <Meta title={title} description={description} image={image} />
    <JsonLd />

    <Font cssVariable="--font-display-face" preload />
    <Font cssVariable="--font-body-face" preload />
    <Font cssVariable="--font-mono-face" />

    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b border-border sticky top-0 z-30 bg-bg">
      <div class="mx-auto max-w-6xl px-6 py-5 flex items-center justify-between">
        <a href={withBase('/')} class="font-display font-bold text-lg tracking-tight text-ink hover:text-signal transition-colors">
          Sergio Seva Rayos
        </a>

        <nav class="hidden sm:flex items-center gap-6 font-label text-xs text-ink-dim">
          <a href={withBase('/proyectos')} class="hover:text-signal transition-colors">Proyectos</a>
          <a href={withBase('/sobre-mi')} class="hover:text-signal transition-colors">Sobre mí</a>
          <a href="mailto:sergiosevarayos@gmail.com" class="hover:text-signal transition-colors">Contacto</a>
        </nav>
      </div>
    </header>

    <!-- Mobile nav: floating thumb-zone trigger + side drawer, sm:hidden throughout -->
    <div
      data-mobile-menu-backdrop
      class="sm:hidden fixed inset-0 bg-black/60 z-40 opacity-0 pointer-events-none transition-opacity duration-300"
      aria-hidden="true"
    >
    </div>

    <nav
      id="mobile-nav"
      data-mobile-menu
      class="sm:hidden fixed top-0 right-0 z-50 h-full w-72 max-w-[80vw] bg-panel border-l border-border flex flex-col pt-24 translate-x-full transition-transform duration-300 ease-out"
    >
      <a href={withBase('/proyectos')} class="block px-6 py-4 font-label text-xs text-ink-dim hover:text-signal hover:bg-panel-raised transition-colors border-b border-border">
        Proyectos
      </a>
      <a href={withBase('/sobre-mi')} class="block px-6 py-4 font-label text-xs text-ink-dim hover:text-signal hover:bg-panel-raised transition-colors border-b border-border">
        Sobre mí
      </a>
      <a href="mailto:sergiosevarayos@gmail.com" class="block px-6 py-4 font-label text-xs text-ink-dim hover:text-signal hover:bg-panel-raised transition-colors">
        Contacto
      </a>
    </nav>

    <button
      type="button"
      data-mobile-menu-toggle
      aria-expanded="false"
      aria-controls="mobile-nav"
      class="fab-toggle sm:hidden fixed bottom-6 right-6 w-14 h-14 rounded-full bg-signal text-bg shadow-lg shadow-black/40 flex items-center justify-center active:scale-95 transition-transform"
    >
      <span class="sr-only">Abrir menú</span>
      <svg
        data-robot-icon
        class="robot-icon relative w-7 h-7"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="12" y1="2" x2="12" y2="5" />
        <circle class="robot-antenna-tip" cx="12" cy="2" r="1.3" fill="currentColor" stroke="none" />
        <rect x="5" y="5" width="14" height="12" rx="3" />
        <circle class="robot-eye robot-eye-normal" cx="9.5" cy="11" r="1.2" fill="currentColor" stroke="none" />
        <circle class="robot-eye robot-eye-normal" cx="14.5" cy="11" r="1.2" fill="currentColor" stroke="none" />
        <path class="robot-eye robot-eye-happy" d="M8.2 11.6 Q9.5 9.6 10.8 11.6" />
        <path class="robot-eye robot-eye-happy" d="M13.2 11.6 Q14.5 9.6 15.8 11.6" />
        <line x1="9.5" y1="14.7" x2="14.5" y2="14.7" />
        <line x1="5" y1="10" x2="3" y2="10" />
        <line x1="19" y1="10" x2="21" y2="10" />
      </svg>
    </button>

    <style>
      .fab-toggle {
        z-index: 60;
      }
      .robot-icon {
        transform-origin: 50% 65%;
        transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      }
      .fab-toggle[aria-expanded='true'] .robot-icon {
        transform: rotate(-10deg) scale(1.08);
      }
      .robot-icon.robot-bounce {
        animation: robot-bounce 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      }
      .robot-eye-happy {
        opacity: 0;
        transition: opacity 0.2s ease;
      }
      .robot-eye-normal {
        transition: opacity 0.2s ease;
      }
      .fab-toggle[aria-expanded='true'] .robot-eye-normal {
        opacity: 0;
      }
      .fab-toggle[aria-expanded='true'] .robot-eye-happy {
        opacity: 1;
      }
      .robot-antenna-tip {
        transform-origin: 12px 2px;
        animation: robot-antenna-blink 2.4s ease-in-out infinite;
      }
      .fab-toggle[aria-expanded='true'] .robot-antenna-tip {
        animation: none;
      }
      @keyframes robot-antenna-blink {
        0%, 100% {
          opacity: 1;
          transform: scale(1);
        }
        50% {
          opacity: 0.4;
          transform: scale(1.5);
        }
      }
      @keyframes robot-bounce {
        0% {
          transform: rotate(0deg) scale(1);
        }
        35% {
          transform: rotate(-14deg) scale(1.15);
        }
        65% {
          transform: rotate(8deg) scale(1.05);
        }
        100% {
          transform: rotate(0deg) scale(1);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .robot-antenna-tip,
        .robot-icon.robot-bounce {
          animation: none;
        }
        .robot-antenna-tip {
          opacity: 1;
        }
        .robot-icon {
          transition: none;
        }
      }
    </style>

    <script src="../lib/mobile-menu.client.ts"></script>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-border">
      <div class="mx-auto max-w-6xl px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-3 font-label text-xs text-ink-faint">
        <span>&copy; {new Date().getFullYear()} Sergio Seva Rayos</span>
        <a href="mailto:sergiosevarayos@gmail.com" class="hover:text-signal transition-colors">sergiosevarayos@gmail.com</a>
      </div>
    </footer>
  </body>
</html>
