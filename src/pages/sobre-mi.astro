---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import TechChip from '../components/project/TechChip.astro';
import Prose from '../components/ui/Prose.astro';
import { SKILLS } from '../data/skills';
import portrait from '../assets/sergio-portrait.jpg';
import charlaPhoto from '../assets/charla-robotica.jpg';

const aboutEntry = await getEntry('site', 'about');
const { Content } = await render(aboutEntry);
---

<Base
  title="Sobre mí"
  description="Sergio Seva Rayos — desarrollador de software y hardware. Aplicaciones web, e-commerce y sistemas IoT en producción."
>
  <section class="mx-auto max-w-3xl px-6 py-16">
    <div class="flex items-center gap-5 mb-8">
      <div class="relative shrink-0">
        <Image
          src={portrait}
          alt="Sergio Seva Rayos"
          width={112}
          height={112}
          class="w-20 h-20 sm:w-28 sm:h-28 rounded-full object-cover border border-border grayscale"
        />
        <span class="pointer-events-none absolute -right-1 -top-1 h-3 w-3 border-r border-t border-signal" aria-hidden="true"></span>
        <span class="pointer-events-none absolute -left-1 -bottom-1 h-3 w-3 border-l border-b border-signal" aria-hidden="true"></span>
      </div>
      <div>
        <p class="font-label text-signal text-xs mb-3">Registro personal</p>
        <h1 class="font-display text-3xl sm:text-4xl font-bold text-ink">Sobre mí</h1>
      </div>
    </div>

    <div class="mb-14">
      <Prose>
        <Content />
      </Prose>
    </div>

    <h2 class="font-display text-xl font-bold text-ink mb-6">Stack</h2>
    <div class="space-y-6 mb-14">
      {
        SKILLS.map((group) => (
          <div>
            <p class="font-label text-[0.65rem] text-ink-faint mb-2">{group.label}</p>
            <div class="flex flex-wrap gap-1.5">
              {group.items.map((slug) => (
                <TechChip slug={slug} />
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <h2 class="font-display text-xl font-bold text-ink mb-4">Divulgación</h2>
    <div class="rounded-lg border border-border bg-panel overflow-hidden mb-14">
      <div class="aspect-[4/3] overflow-hidden bg-panel-raised">
        <Image
          src={charlaPhoto}
          alt="Charla de robótica y tecnología en el colegio, alumnos de primaria probando electrónica"
          width={900}
          height={675}
          class="w-full h-full object-cover"
        />
      </div>
      <p class="text-ink-dim leading-relaxed p-5">
        Cada año doy charlas de robótica y tecnología en el colegio de mis hijas, para alumnos de 1º a 6º de
        primaria.
      </p>
    </div>

    <h2 class="font-display text-xl font-bold text-ink mb-4">Formación en curso</h2>
    <div class="rounded-lg border border-border bg-panel p-5">
      <p class="text-ink-dim leading-relaxed mb-3">
        Estudio pentesting y seguridad ofensiva de forma autodidacta: fundamentos de redes, el OWASP Top 10 vulnerabilidad
        por vulnerabilidad, y writeups de máquinas de práctica en TryHackMe y Hack The Box.
      </p>
      <p class="text-sm text-ink-faint">
        Última máquina resuelta: <strong class="text-ink">Vulnversity</strong> (TryHackMe) — escaneo de puertos,
        enumeración de directorios web, subida de shell reverso y escalada de privilegios básica.
      </p>
    </div>
  </section>
</Base>
