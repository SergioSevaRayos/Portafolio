---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada" description="La página que buscas no existe.">
  <section class="mx-auto max-w-2xl px-6 py-32 text-center">
    <p class="font-label text-signal text-xs mb-4">Error 404</p>
    <h1 class="font-display text-3xl sm:text-4xl font-bold text-ink mb-4">Esta página no está en el registro.</h1>
    <p class="text-ink-dim mb-8">La ruta que buscas no existe o se ha movido.</p>
    <a
      href="/"
      class="font-label text-xs px-5 py-3 rounded-full bg-signal text-bg font-medium hover:bg-signal-dim transition-colors inline-block"
    >
      Volver al inicio
    </a>
  </section>
</Base>
