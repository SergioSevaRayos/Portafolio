---
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.pathname;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Sergio Seva Rayos',
  email: 'mailto:sergiosevarayos@gmail.com',
  url: canonicalURL,
  jobTitle: 'Desarrollador full-stack',
  knowsAbout: ['Desarrollo web', 'IoT', 'Astro', 'Vue', 'Laravel', 'Python'],
};
---

<script type="application/ld+json" set:html={JSON.stringify(person)} />
