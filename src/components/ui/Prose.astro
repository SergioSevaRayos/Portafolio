<div class="prose-case-study">
  <slot />
</div>

<style>
  .prose-case-study :global(h2) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    color: var(--color-ink);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .prose-case-study :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }
  .prose-case-study :global(p) {
    color: var(--color-ink-dim);
    line-height: 1.7;
    margin-bottom: 1rem;
  }
  .prose-case-study :global(ul) {
    list-style: none;
    padding: 0;
    margin-bottom: 1rem;
  }
  .prose-case-study :global(li) {
    color: var(--color-ink-dim);
    line-height: 1.6;
    padding-left: 1.25rem;
    position: relative;
    margin-bottom: 0.5rem;
  }
  .prose-case-study :global(li::before) {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    background-color: var(--color-signal);
  }
  .prose-case-study :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }
  .prose-case-study :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background-color: var(--color-panel);
    border: 1px solid var(--color-border);
    padding: 0.1em 0.35em;
    border-radius: 3px;
    color: var(--color-signal);
  }
  .prose-case-study :global(a) {
    color: var(--color-signal);
    text-underline-offset: 2px;
  }
  .prose-case-study :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
  }
  .prose-case-study :global(th) {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.7rem;
    color: var(--color-ink-faint);
    text-align: left;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }
  .prose-case-study :global(td) {
    color: var(--color-ink-dim);
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }
  .prose-case-study :global(tr:last-child td) {
    border-bottom: none;
  }
</style>
