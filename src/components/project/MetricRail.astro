---
interface Props {
  metrics: { label: string; value: string }[];
}

const { metrics } = Astro.props;
---

{
  metrics.length > 0 && (
    <dl class="grid grid-cols-2 sm:grid-cols-4 gap-4 border-y border-border py-5">
      {metrics.map((m) => (
        <div>
          <dt class="font-label text-[0.65rem] text-ink-faint mb-1">{m.label}</dt>
          <dd class="font-display font-bold text-2xl text-signal">{m.value}</dd>
        </div>
      ))}
    </dl>
  )
}
