---
import { resolveTech } from '../../lib/tech';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const tech = resolveTech(slug);
---

<span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-panel px-2.5 py-1 font-label text-[0.65rem] text-ink-dim">
  {
    tech.icon && (
      <svg viewBox="0 0 24 24" width="12" height="12" fill={`#${tech.icon.hex}`} aria-hidden="true">
        <path d={tech.icon.path} />
      </svg>
    )
  }
  {tech.label}
</span>
